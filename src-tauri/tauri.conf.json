{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCMFARM",
  "mainBinaryName": "SCMFARM",
  "version": "0.2.1",
  "identifier": "com.showcasemaker.farm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCMFARM",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://avatars.akamai.steamstatic.com https://avatars.steamstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "showcasemaker.com",
    "homepage": "https://showcasemaker.com",
    "shortDescription": "Steam card farming on your own PC",
    "copyright": "Copyright 2026 showcasemaker.com. Apache-2.0. Engine: ArchiSteamFarm (Apache-2.0)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
